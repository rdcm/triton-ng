name: "bench_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 1, 28, 28 ]
  }
]

output [
  {
    name: "Plus214_Output_0"
    data_type: TYPE_FP32
    dims: [ 1, 10 ]
  }
]

instance_group [
  {
    count: 4
    kind: KIND_CPU
  }
]

parameters: {
  key: "intra_op_thread_count"
  value: { string_value: "1" }
}

parameters: {
  key: "inter_op_thread_count"
  value: { string_value: "1" }
}
