name: "cpu_parallel"
backend: "custom_backend"
max_batch_size: 8

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 28, 28 ]
  }
]

output [
  {
    name: "DIGIT"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

# DeviceBlocking shares execution threads only between non-passive GPU instances;
# CPU instances still execute concurrently.
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}

parameters: {
  key: "identity_model"
  value: { string_value: "identity_gpu" }
}

parameters: { key: "fixture" value: { string_value: "concurrency" } }
