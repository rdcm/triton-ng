name: "cpu_parallel"
backend: "custom_backend"
max_batch_size: 8

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 28, 28 ]
  }
]

output [
  {
    name: "DIGIT"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

# Two CPU instances. `ExecutionPolicy::DeviceBlocking` shares an execution
# thread only between the non-passive GPU instances of one model and device, so
# these two keep running at the same time; the test that measures the GPU
# fixture uses this one to show the policy does not reach them.
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}

parameters: {
  key: "identity_model"
  value: { string_value: "identity_gpu" }
}
