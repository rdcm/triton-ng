name: "mnist"
backend: "custom_backend"
max_batch_size: 8

dynamic_batching {
  max_queue_delay_microseconds: 1000
}

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 28, 28 ]
  }
]

output [
  {
    name: "Plus214_Output_0"
    data_type: TYPE_FP32
    dims: [ 10 ]
  }
]

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}
