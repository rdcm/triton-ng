name: "mnist"
backend: "custom_backend"
max_batch_size: 0

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 1, 28, 28 ]
  }
]

output [
  {
    name: "Plus214_Output_0"
    data_type: TYPE_FP32
    dims: [ 1, 10 ]
  }
]

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}