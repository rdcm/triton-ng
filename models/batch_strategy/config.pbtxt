name: "batch_strategy"
backend: "custom_backend"
max_batch_size: 4

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 28, 28 ]
  }
]

output [
  {
    name: "DIGIT"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 200000
  # Naming a queue policy turns prefetching off: Triton prefetches only while
  # the policy has no timeout, no timeout override and no queue size. With
  # prefetching on, Triton lets the batcher fill one more payload while the
  # only instance is busy, so a request holding the instance does not keep the
  # requests behind it in the queue and the test cannot see the batches the
  # strategy formed.
  default_queue_policy {
    allow_timeout_override: true
  }
}

# One instance: the test fills its queue and reads back the batches it formed.
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

# The strategy library `make build` produces, mounted into the container by
# the `triton` service of `docker-compose.yml`.
parameters: {
  key: "TRITON_BATCH_STRATEGY_PATH"
  value: { string_value: "/strategies/batchstrategy.so" }
}

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}

parameters: {
  key: "identity_model"
  value: { string_value: "identity_gpu" }
}
