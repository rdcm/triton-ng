name: "device_blocking"
backend: "custom_backend_device_blocking"
max_batch_size: 8

input [
  {
    name: "Input3"
    data_type: TYPE_FP32
    dims: [ 1, 28, 28 ]
  }
]

output [
  {
    name: "DIGIT"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

# Non-passive GPU instances on one device share a DeviceBlocking execution thread.
instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

parameters: {
  key: "target_model"
  value: { string_value: "mnist_onnx" }
}

parameters: {
  key: "identity_model"
  value: { string_value: "identity_gpu" }
}

parameters: { key: "fixture" value: { string_value: "concurrency" } }
